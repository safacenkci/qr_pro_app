# /opt/qrpro/.env olarak kopyalayın (cp .env.example .env && chmod 600 .env).

# Zorunlu: Postgres parolası (yalnızca compose iç ağında kullanılır). Rastgele üretin:
#   openssl rand -hex 24
# Yalnızca harf ve rakam kullanın (bağlantı dizesine olduğu gibi yazılır).
POSTGRES_PASSWORD=

# Aşağıdakilerin hepsi isteğe bağlıdır.

# Gizlilik politikasındaki silme talebi iletişim adresi. Boşsa "Google Play mağaza sayfasındaki
# geliştirici iletişim adresi" yazılır. Örnek: CONTACT_EMAIL=destek@ornek.com
CONTACT_EMAIL=

# Gizlilik ve veri silme sayfalarındaki geliştirici adı (Play Console'daki ad). Boşsa "Cenkci Studios".
DEVELOPER_NAME=

# Beklenen uygulama ve ürün kimliği.
PACKAGE_NAME=com.safarahmancenkci.qrpro
PRODUCT_ID=qr_pro_lifetime

# Kötüye kullanım koruması: gövde boyutu (bayt) ve IP başına dakikalık istek sınırı.
MAX_BODY_BYTES=8192
RATE_LIMIT_PER_MINUTE=30

# Google Play API zaman aşımı (saniye).
GOOGLE_TIMEOUT=10
