# /opt/qrpro/.env olarak kopyalayın (cp .env.example .env). Hepsi isteğe bağlıdır.

# Gizlilik politikasındaki silme talebi iletişim adresi. Boşsa "Google Play mağaza sayfasındaki
# geliştirici iletişim adresi" yazılır.
CONTACT_EMAIL=

# Beklenen uygulama ve ürün kimliği.
PACKAGE_NAME=com.safarahmancenkci.qrpro
PRODUCT_ID=qr_pro_lifetime

# Kötüye kullanım koruması: gövde boyutu (bayt) ve IP başına dakikalık istek sınırı.
MAX_BODY_BYTES=8192
RATE_LIMIT_PER_MINUTE=30

# Google Play API zaman aşımı (saniye).
GOOGLE_TIMEOUT=10
